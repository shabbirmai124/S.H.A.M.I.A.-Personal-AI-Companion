# GEMINI_API_KEY: Optional server-side Gemini AI API key.
# Never commit .env files or share real keys.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# HF_TOKEN: Optional free Hugging Face Inference token for online open-source 1.5B-2B models.
HF_TOKEN="MY_HUGGINGFACE_TOKEN"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
